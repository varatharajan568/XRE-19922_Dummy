+resolve_external_wpe_toolchain()
+{
+    local candidates=()
+    local root=""
+    local cfg1=""
+    local cfg2=""
+    local p1=""
+    local p2=""
+    local p3=""
+    local p4=""
+    local f=""
+
+    if [[ -n "${EXT_INSTALL_ROOT}" ]]; then
+        candidates+=("${EXT_INSTALL_ROOT}")
+    fi
+
+    candidates+=(
+        "${GITHUB_WORKSPACE}/install"
+        "/usr/local"
+        "/usr"
+        "/opt/homebrew"
+        "/opt/homebrew/opt/wpeframework"
+        "/opt/homebrew/opt/wpeframeworkplugins"
+    )
+
+    # Include Homebrew prefixes even when formulae are not linked globally.
+    for f in wpeframework wpeframeworkplugins wpeframework-plugins; do
+        brew_append_formula_prefix_if_present "${f}" candidates
+    done
+
+    for root in "${candidates[@]}"; do
+        cfg1="${root}/usr/lib/cmake/WPEFramework/WPEFrameworkConfig.cmake"
+        cfg2="${root}/lib/cmake/WPEFramework/WPEFrameworkConfig.cmake"
+        p1="${root}/usr/lib/cmake/WPEFrameworkPlugins/WPEFrameworkPluginsConfig.cmake"
+        p2="${root}/lib/cmake/WPEFrameworkPlugins/WPEFrameworkPluginsConfig.cmake"
+        p3="${root}/usr/lib/cmake/WPEFrameworkPlugins/PluginsConfig.cmake"
+        p4="${root}/lib/cmake/WPEFrameworkPlugins/PluginsConfig.cmake"
+
+        EXTERNAL_WPE_CONFIG=""
+        EXTERNAL_WPE_PLUGINS_CONFIG=""
+
+        if [[ -f "${cfg1}" ]]; then
+            EXTERNAL_WPE_CONFIG="${cfg1}"
+        elif [[ -f "${cfg2}" ]]; then
+            EXTERNAL_WPE_CONFIG="${cfg2}"
+        else
+            continue
+        fi
+
+        if [[ -f "${p1}" ]]; then
+            EXTERNAL_WPE_PLUGINS_CONFIG="${p1}"
+        elif [[ -f "${p2}" ]]; then
+            EXTERNAL_WPE_PLUGINS_CONFIG="${p2}"
+        elif [[ -f "${p3}" ]]; then
+            EXTERNAL_WPE_PLUGINS_CONFIG="${p3}"
+        elif [[ -f "${p4}" ]]; then
+            EXTERNAL_WPE_PLUGINS_CONFIG="${p4}"
+        else
+            continue
+        fi
+
+        EXT_INSTALL_ROOT="${root}"
+        return 0
+    done
+
+    return 1
+}
