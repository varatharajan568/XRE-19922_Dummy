+fail_unsupported_macos_thunder_build()
+{
+        cat <<'EOF'
+ERROR: Full dependency bootstrap is not supported on this macOS host.
+
+The pinned Thunder/WPEFramework sources used by this script currently fail on
+macOS for repository-level reasons, including:
+- Thunder Source/core/Time.h colliding with system <time.h> on default
+    case-insensitive macOS filesystems.
+- Linux-only headers and sources in the pinned Thunder core build, such as
+    linux/rtnetlink.h.
+
+Use one of these options instead:
+1. Run build_dependencies.sh on Ubuntu/Linux, matching the CI environment.
+2. Use a Linux VM/container for the dependency bootstrap.
+3. Provide an existing external WPEFramework/WPEFrameworkPlugins install and
+     use Tests/L1Tests/run.sh against that toolchain.
+EOF
+        exit 1
+}
