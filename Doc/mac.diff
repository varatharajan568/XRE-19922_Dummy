+brew_install_formula_if_missing()
+{
+    local formula="$1"
+
+    if brew list --versions "${formula}" >/dev/null 2>&1; then
+        return 0
+    fi
+
+    brew install "${formula}"
+}
+
+brew_install_first_available_formula()
+{
+    local formula=""
+
+    for formula in "$@"; do
+        if brew info "${formula}" >/dev/null 2>&1; then
+            brew_install_formula_if_missing "${formula}"
+            return 0
+        fi
+    done
+
+    return 1
+}
+
+brew_append_formula_prefix_if_present()
+{
+    local formula="$1"
+    local out_var="$2"
+    local prefix=""
+
+    prefix="$(brew --prefix "${formula}" 2>/dev/null || true)"
+    if [[ -n "${prefix}" ]]; then
+        eval "${out_var}+=(\"${prefix}\")"
+    fi
+}
